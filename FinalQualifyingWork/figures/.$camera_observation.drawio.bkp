<mxfile host="Electron" agent="Mozilla/5.0" version="29.3.6">
  <diagram id="camera-obs" name="CameraObservation §3.5">
    <mxGraphModel dx="1100" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="800" pageHeight="1280" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#1a1a1a;" value="Формирование CameraObservation по кадру видео (offline)&#xa;§ 3.5 ВКР — YOLO → привязка ворот → PnP → xyz_obs" vertex="1">
          <mxGeometry x="40" y="15" width="720" height="50" as="geometry" />
        </mxCell>

        <mxCell id="start" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#e65100;fontSize=12;fontStyle=1;" value="Кадр сессии&#xa;video.mp4" vertex="1">
          <mxGeometry x="280" y="80" width="240" height="55" as="geometry" />
        </mxCell>

        <mxCell id="input" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=8;" value="&lt;b&gt;Вход кадра:&lt;/b&gt; frame_idx, ts_wall&#xa;(из video_timestamps.parquet)" vertex="1">
          <mxGeometry x="220" y="150" width="360" height="45" as="geometry" />
        </mxCell>

        <mxCell id="dprior" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" value="Есть coarse prior&#xa;(telemetry.parquet)?" vertex="1">
          <mxGeometry x="255" y="215" width="210" height="85" as="geometry" />
        </mxCell>

        <mxCell id="skip-prior" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#9e9e9e;fontSize=11;" value="Пропуск кадра&#xa;(нет привязки по времени)" vertex="1">
          <mxGeometry x="520" y="220" width="200" height="55" as="geometry" />
        </mxCell>

        <mxCell id="prior" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1976d2;fontSize=11;align=left;spacingLeft=10;spacingTop=6;" value="&lt;b&gt;Coarse prior&lt;/b&gt; (грубая позиция)&#xa;• ближайший ts в telemetry: pos_x, pos_y, pos_z&#xa;• обычно из PF/KF или симулятора&#xa;• неопределённость q_m (prior_q_m)" vertex="1">
          <mxGeometry x="150" y="320" width="500" height="75" as="geometry" />
        </mxCell>

        <mxCell id="yolo" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;fontSize=11;align=left;spacingLeft=10;spacingTop=6;" value="&lt;b&gt;1. YOLO (детекция ворот)&lt;/b&gt;&#xa;• класс gate, bbox на изображении&#xa;• 4 keypoints — внутренние углы ворот (пиксели)&#xa;• фильтр: conf ключевых точек, площадь bbox" vertex="1">
          <mxGeometry x="150" y="415" width="500" height="80" as="geometry" />
        </mxCell>

        <mxCell id="ddets" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" value="Есть валидные&#xa;детекции?" vertex="1">
          <mxGeometry x="275" y="515" width="180" height="80" as="geometry" />
        </mxCell>

        <mxCell id="no-dets" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828;fontSize=11;" value="rejected&#xa;нет детекций / низкий conf" vertex="1">
          <mxGeometry x="520" y="520" width="180" height="55" as="geometry" />
        </mxCell>

        <mxCell id="candidates" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8eaf6;strokeColor=#3949ab;fontSize=11;align=left;spacingLeft=10;spacingTop=6;" value="&lt;b&gt;2. Кандидаты gate_id&lt;/b&gt; (CoarseRefine)&#xa;• карта ворот трассы: 3D-углы каждых ворот&#xa;• кольца near/mid/far вокруг coarse prior на плоскости XZ&#xa;• для каждой детекции — список возможных номеров ворот" vertex="1">
          <mxGeometry x="150" y="620" width="500" height="85" as="geometry" />
        </mxCell>

        <mxCell id="topk-pnp" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1565c0;fontSize=11;align=left;spacingLeft=10;spacingTop=6;" value="&lt;b&gt;3. Top-K + PnP (оценка позиции камеры/БВС)&lt;/b&gt;&#xa;• перебор гипотез: какое ворото = какая детекция&#xa;• PnP: 3D-углы ворот ↔ 2D-пиксели + калибровка K&#xa;• выбор гипотезы ближе к coarse prior, мин. reprojection RMSE&#xa;• cheirality: камера перед плоскостью ворот" vertex="1">
          <mxGeometry x="150" y="725" width="500" height="100" as="geometry" />
        </mxCell>

        <mxCell id="dsuccess" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" value="refine.success&#xa;и q_out допустим?" vertex="1">
          <mxGeometry x="255" y="850" width="210" height="85" as="geometry" />
        </mxCell>

        <mxCell id="reject" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828;fontSize=11;align=left;spacingLeft=8;" value="&lt;b&gt;CameraObservation rejected&lt;/b&gt;&#xa;status=rejected, reason&#xa;(далеко от prior / высокий q / нет гипотез)" vertex="1">
          <mxGeometry x="520" y="855" width="220" height="70" as="geometry" />
        </mxCell>

        <mxCell id="obs-ok" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#2e7d32;fontSize=11;align=left;spacingLeft=10;spacingTop=6;strokeWidth=2;" value="&lt;b&gt;4. CameraObservation (ok)&lt;/b&gt;&#xa;• xyz_obs — position_world из PnP, м&#xa;• sigma_cam ← q_out_m&#xa;• gate_id, confidence, reprojection_error_px&#xa;• bbox_xyxy, keypoints (Replay overlay)" vertex="1">
          <mxGeometry x="150" y="960" width="500" height="95" as="geometry" />
        </mxCell>

        <mxCell id="output" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" value="Запись&#xa;camera_observations.jsonl" vertex="1">
          <mxGeometry x="270" y="1080" width="260" height="55" as="geometry" />
        </mxCell>

        <mxCell id="inject-note" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#f9a825;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#444;" value="&lt;b&gt;Далее (§ 3.6):&lt;/b&gt; inject_position_observation(xyz_obs, sigma_cam)&#xa;→ байесовское обновление весов частиц PF" vertex="1">
          <mxGeometry x="150" y="1155" width="500" height="55" as="geometry" />
        </mxCell>

        <mxCell id="pnp-math" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#43a047;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#333;" value="&lt;b&gt;Идея PnP:&lt;/b&gt; 3D-углы ворот на трассе + 2D от YOLO&#xa;→ поза камеры (xyz_obs)" vertex="1">
          <mxGeometry x="20" y="740" width="115" height="70" as="geometry" />
        </mxCell>

