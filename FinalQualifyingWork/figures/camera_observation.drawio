        <mxCell id="e16" edge="1" parent="1" source="output" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1;dashed=1;dashPattern=4 4;endArrow=classic;endFill=1;strokeColor=#f9a825;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="400" y="1255" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="thyqFJQWp13R_mwWjIV9-1" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#1a1a1a;" value="Цикл одного шага Particle Filter (DCT)&#xa;состояние частицы: (s, v) — позиция на дуге трассы, м; скорость, м/с" vertex="1">
          <mxGeometry height="50" width="640" x="830" y="5" as="geometry" />
        </mxCell>
        <mxCell id="thyqFJQWp13R_mwWjIV9-2" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" value="Начало шага&#xa;update(stick_norm, dt)" vertex="1">
          <mxGeometry height="55" width="200" x="1060" y="65" as="geometry" />
        </mxCell>
        <mxCell id="thyqFJQWp13R_mwWjIV9-3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=8;" value="&lt;b&gt;Вход:&lt;/b&gt; нормализованный вектор RC stick_norm;&lt;br&gt;интервал dt с предыдущего шага (сек)" vertex="1">
          <mxGeometry height="50" width="320" x="1000" y="135" as="geometry" />
        </mxCell>
        <mxCell id="thyqFJQWp13R_mwWjIV9-4" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" value="Фильтр&#xa;инициализирован?" vertex="1">
          <mxGeometry height="80" width="210" x="1055" y="220" as="geometry" />
        </mxCell>
        <mxCell id="thyqFJQWp13R_mwWjIV9-5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;" value="&lt;b&gt;reset()&lt;/b&gt;&lt;br&gt;частицы у старта и финиша круга;&lt;br&gt;равномерные веса w = 1/N" vertex="1">
          <mxGeometry height="80" width="200" x="1320" y="220" as="geometry" />
        </mxCell>
        <mxCell id="thyqFJQWp13R_mwWjIV9-6" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" value="dt задан&#xa;и dt &amp;gt; 0?" vertex="1">
          <mxGeometry height="80" width="210" x="1055" y="340" as="geometry" />
        </mxCell>
        <mxCell id="thyqFJQWp13R_mwWjIV9-7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=10;spacingTop=6;" value="&lt;b&gt;1. Predict (предсказание)&lt;/b&gt;&lt;br&gt;• v ← v + N(0, q_v·√dt), ограничение [v_min, v_max]&lt;br&gt;• s ← s + v·dt + N(0, q_s·√dt)&lt;br&gt;• s ← s mod L (циклический круг)" vertex="1">
          <mxGeometry height="80" width="460" x="930" y="460" as="geometry" />
        </mxCell>
        <mxCell id="thyqFJQWp13R_mwWjIV9-8" parent="1" style="text;html=1;strokeColor=none;fillColor=none;fontSize=10;fontColor=#888888;align=center;" value="пропуск predict&#xa;(первый шаг)" vertex="1">
          <mxGeometry height="40" width="110" x="1315" y="340" as="geometry" />
        </mxCell>
        <mxCell id="thyqFJQWp13R_mwWjIV9-9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=10;spacingTop=6;" value="&lt;b&gt;2. Weight update (обновление весов)&lt;/b&gt;&lt;br&gt;• ближайший узел референса по s (searchsorted)&lt;br&gt;• невязка d² по норм. RC-признакам (веса каналов)&lt;br&gt;• w_i ∝ exp(−0.5·d²/σ²_obs), нормализация Σw = 1" vertex="1">
          <mxGeometry height="80" width="460" x="930" y="580" as="geometry" />
        </mxCell>
        <mxCell id="thyqFJQWp13R_mwWjIV9-10" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" value="ESS &amp;lt; ess_thr·N?&#xa;ESS = 1/Σw²" vertex="1">
          <mxGeometry height="80" width="210" x="1055" y="700" as="geometry" />
        </mxCell>
        <mxCell id="thyqFJQWp13R_mwWjIV9-11" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=10;spacingTop=6;" value="&lt;b&gt;3. Resampling (ресемплинг)&lt;/b&gt;&lt;br&gt;• систематический ресемплинг по w&lt;br&gt;• roughening: s += N(0, roughening_s)&lt;br&gt;• random inject: доля частиц → U(0, L) по s&lt;br&gt;• w ← 1/N" vertex="1">
          <mxGeometry height="80" width="460" x="930" y="820" as="geometry" />
        </mxCell>
        <mxCell id="thyqFJQWp13R_mwWjIV9-12" parent="1" style="text;html=1;strokeColor=none;fillColor=none;fontSize=10;fontColor=#888888;align=center;" value="ресемплинг&#xa;не нужен" vertex="1">
          <mxGeometry height="40" width="100" x="1320" y="700" as="geometry" />
        </mxCell>
        <mxCell id="thyqFJQWp13R_mwWjIV9-13" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=10;spacingTop=6;" value="&lt;b&gt;4. Circular mean (оценка положения)&lt;/b&gt;&lt;br&gt;• θ = 2π·s/L; взвешенные cos θ, sin θ&lt;br&gt;• s_est — угол на окружности; σ — неопределённость" vertex="1">
          <mxGeometry height="80" width="460" x="930" y="940" as="geometry" />
        </mxCell>
        <mxCell id="thyqFJQWp13R_mwWjIV9-14" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" value="Выход: s_est, σ" vertex="1">
          <mxGeometry height="50" width="180" x="1070" y="1050" as="geometry" />
        </mxCell>
        <mxCell id="thyqFJQWp13R_mwWjIV9-15" edge="1" parent="1" source="thyqFJQWp13R_mwWjIV9-2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;" target="thyqFJQWp13R_mwWjIV9-3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="thyqFJQWp13R_mwWjIV9-16" edge="1" parent="1" source="thyqFJQWp13R_mwWjIV9-3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;" target="thyqFJQWp13R_mwWjIV9-4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="thyqFJQWp13R_mwWjIV9-17" edge="1" parent="1" source="thyqFJQWp13R_mwWjIV9-4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" target="thyqFJQWp13R_mwWjIV9-5" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;нет&lt;/font&gt;">
          <mxGeometry relative="1" x="-0.3091" y="12" as="geometry">
            <mxPoint as="offset" />
